from PySide6.QtWidgets import QApplication, QWidget, QPushButton, QSpinBox, QLabel, QTableWidget, QTableWidgetItem, QFileDialog
from about_window import AboutWindow

class MainWindow(QWidget):

    def __init__(self):
        super().__init__()

        self.setWindowTitle('Grades Fixer')
        self.setGeometry(200,200,600,700)

        self.student_ids = []
        self.original_grades = []
        self.corrected_grades = []
        self.selected_file = ''

        self.about_window = AboutWindow()

        self.load_button = QPushButton('Load Grades File', self)
        self.load_button.setGeometry(20,20,200,35)
        self.load_button.clicked.connect(self.load_method)

        self.bonus_label = QLabel('Bonus points:', self)
        self.bonus_label.setGeometry(240,20,100,35)

        self.bonus_box = QSpinBox(self)
        self.bonus_box.setGeometry(340,20,80,35)
        self.bonus_box.setRange(0,100)

        self.percent_label = QLabel('Bonus %', self)
        self.percent_label.setGeometry(440,20,70,35)

        self.percent_box = QSpinBox(self)
        self.percent_box.setGeometry(510,20,70,35)
        self.percent_box.setRange(0,100)
        self.percent_box.editingFinished.connect(self.bonus_method)

        self.table = QTableWidget(50,3,self)
        self.table.setGeometry(20,75,560,520)
        self.table.setHorizontalHeaderLabels(['ID','Original Grades','Corrected Grades'])

        self.update_button = QPushButton('Update File', self)
        self.update_button.setGeometry(20,620,200,35)
        self.update_button.clicked.connect(self.update_file_method)

        self.about_button = QPushButton('About', self)
        self.about_button.setGeometry(240,620,100,35)
        self.about_button.clicked.connect(self.show_about)

    def load_method(self):
        result = QFileDialog.getOpenFileName(self, 'Select students file', '', 'CSV files (*.csv)')
        filename = result[0]
        if not filename: return


        self.selected_file = filename
        self.student_ids = []
        self.original_grades = []
        self.corrected_grades = []

        with open(self.selected_file) as f:
            lines = f.readlines()

        for line in lines[1:]:
            parts = line.strip().split(',')
            self.student_ids.append(parts[0])
            self.original_grades.append(int(parts[1]))
            self.corrected_grades.append(int(parts[1]))

        self.update_table()        

    def update_file_method(self):
        bonus = self.bonus_box.value()

        for i in range(len(self.original_grades)):
            self.corrected_grades[i] = min(self.original_grades[i] + bonus , 100)

        self.update_table()

    def bonus_method(self):
        points = self.bonus_box.value()
        percent = self.percent_box.value()

        for i in range(len(self.original_grades)):
            new_grade = self.original_grades[i] + points + self.original_grades[i] * percent / 100
            new_grade = round(new_grade)
            if new_grade > 100: new_grade = 100
            self.corrected_grades[i] = new_grade


        self.update_table()

    def update_table(self):
        self.table.setRowCount(len(self.student_ids))
        for i in range(len(self.student_ids)):
            self.table.setItem(i,0,QTableWidgetItem(str(self.student_ids[i])))
            self.table.setItem(i,1,QTableWidgetItem(str(self.original_grades[i])))
            self.table.setItem(i,2,QTableWidgetItem(str(self.corrected_grades[i])))

    def show_about(self):
        self.about_window.show()


if __name__ == '__main__':
    app = QApplication()
    with open('q1.qss') as f:
        app.setStyleSheet(f.read())
    window = MainWindow()
    window.show()
    app.exec()